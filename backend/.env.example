PROJECT_NAME="AI Data Readiness Platform"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database: leave unset to use a local SQLite file (backend/datareadiness.db)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional Gemini explanations (falls back to statistical explanations when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=["gemini-3.7-flash"]
# GEMINI_TIMEOUT_SEC=30
# GEMINI_MAX_RETRIES=2
# GEMINI_TOTAL_BUDGET_SEC=45

# Limits & retention
MAX_UPLOAD_MB=200
MIN_ROWS=10
FILE_RETENTION_DAYS=7
