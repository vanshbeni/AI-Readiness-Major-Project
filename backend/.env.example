PROJECT_NAME="AI Data Readiness Platform"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database: leave unset to use a local SQLite file (backend/datareadiness.db)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Agents (Understand / Clean / Evaluate / Report / Analyst) via OpenRouter.
# Get a key at https://openrouter.ai/keys. Without it, every agent uses its deterministic rules.
OPENROUTER_API_KEY=
# "openrouter/free" picks an available free model per request; pin one if you prefer.
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=["nvidia/nemotron-3.5-super-vl:free","google/gemma-4-31b-it:free"]
# LLM_TIMEOUT_SEC=90
# AGENT_MAX_STEPS=8
# Wall-clock budget per agent run (autopilot shares one budget across all phases; free reasoning models are slow)
# AGENT_RUN_BUDGET_SEC=300
# What agents may send to the LLM: schema | aggregates | samples (redacted)
# AI_PRIVACY_MODE=samples

# Limits & retention
MAX_UPLOAD_MB=200
MIN_ROWS=10
FILE_RETENTION_DAYS=7
